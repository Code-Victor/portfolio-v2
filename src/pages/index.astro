---
import AvatarImage from "@/assets/images/avatar.png";
import Hero from "@/components/hero.astro";
import { Navbar } from "@/components/navbar";
import RecentWorks from "@/components/recent-works.astro";
import BaseHead from "../components/base-head.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import ProgressiveBlur from "@/components/progressive-blur.astro";
import { getImage } from "astro:assets";
import Texture from "@/components/texture.astro";
import Journey from "@/components/journey.astro";

const optimizedAvatar = await getImage({
  src: AvatarImage,
  width: 128,
  height: 128,
});
optimizedAvatar;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="font-body bg-background text-foreground relative min-h-screen">
    <Navbar avatar={optimizedAvatar} client:load />
    <Hero />
    <RecentWorks />
    <Journey />
    <div class="h-screen"></div>
    <div class="h-screen"></div>
    <div class="h-screen"></div>
    <ProgressiveBlur />
    <Texture />
  </body>
</html>
